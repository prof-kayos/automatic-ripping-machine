# Non-secret settings for arm-pipeline (copy to /etc/arm-pipeline/arm-pipeline.conf). Secrets go in secrets.env.
ARM_MOVIES_DIR=/mnt/movies
ARM_SCRATCH_DIR=/scratch
ARM_SR_DEV=/dev/sr0
ARM_SG_DEV=/dev/sg1
# media servers: URLs, and the movies path AS EACH SERVER SEES IT (can differ from ARM_MOVIES_DIR)
JELLYFIN_URL=http://jellyfin.example.invalid:8096
ARM_JELLYFIN_MOVIES_PATH=/mnt/nas/movies
# Plex serves a *.plex.direct certificate: connect with https://<ip-with-dashes>.<your-server-hash>.plex.direct:32400
# (resolves to the server's LAN IP and verifies). A custom hostname fails certificate verification.
PLEX_URL=https://10-0-0-1.0000000000000000.plex.direct:32400
PLEX_SECTION_ID=1
ARM_PLEX_MOVIES_PATH=/mnt/nas/movies
# a replacement always waits for approval unless this is 1 AND the folder matched exactly
ARM_AUTO_REPLACE=0
# 1 = also run the slow full decode on every rip (roughly realtime on a 4K HEVC title, so about as long as the rip; off by default, runs automatically on suspicion)
ARM_VERIFY_FULL_DECODE=0

# --- dashboard (arm-dashboard.service). The token itself goes in secrets.env as DASHBOARD_TOKEN (>= 32 random chars).
# Bind to the machine's LAN address (not 0.0.0.0) and list every Host name you will type in the browser.
ARM_DASHBOARD_BIND=192.0.2.10
ARM_DASHBOARD_PORT=8088
ARM_DASHBOARD_ALLOWED_HOSTS=192.0.2.10,ripper,localhost,127.0.0.1
