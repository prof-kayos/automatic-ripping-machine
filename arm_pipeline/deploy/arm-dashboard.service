[Unit]
Description=ARM pipeline web dashboard
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
# numeric ids: the uid that owns the media share mount (see docs); groups give access to the passed-through drive
User=1000
Group=1000
WorkingDirectory=/opt/arm
Environment=PYTHONPATH=/opt/arm
Environment=PYTHONUNBUFFERED=1
# secrets (mode 600, never in git) and non-secret settings; no `export`, quote values containing '#'
EnvironmentFile=/etc/arm-pipeline/secrets.env
EnvironmentFile=/etc/arm-pipeline/arm-pipeline.conf
ExecStart=/usr/bin/python3 -m arm_pipeline.dashboard
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
NoNewPrivileges=yes
UMask=0027
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=256M
ProtectKernelTunables=yes
ProtectControlGroups=yes
# Deliberately NOT using ProtectSystem/ProtectHome/PrivateTmp: mount namespacing can fail (status 226) in an
# unprivileged container, and the daemon only needs the paths it is configured with.

[Install]
WantedBy=multi-user.target
